# 이 파일을 .env로 복사하고 필요한 값을 설정한다. .env는 커밋하지 않는다.
# Jev 키. 둘 중 하나만 있어도 된다. 둘 다 있으면 TypeSafe 공식 API(TYPESAFE_API_KEY)를 쓴다.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# 정상 작업 확인 주기(분). worker_done·질문·오류는 즉시 처리한다.
FULLOPS_WORKER_CHECK_MINUTES=60
# worker-start의 준비 대기 시간(초).
FULLOPS_WORKER_READY_TIMEOUT_SECONDS=90
# worker-read·terminal read 한 번의 --limit 상한(해당 명령의 메시지/줄 단위).
FULLOPS_WORKER_LOG_LIMIT=30
