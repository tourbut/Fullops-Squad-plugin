{
  "schema_version": 1,
  "commands": [],
  "timeout_seconds": 600,
  "size": {
    "severity": "WARNING",
    "max_code_lines": 300,
    "max_doc_lines": 500,
    "max_diff_added": 400
  },
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/vendor/**",
    "**/*.min.*",
    "**/*.lock",
    "**/package-lock.json",
    ".fullops-squad/handovers/**",
    ".fullops-squad/contexts/**",
    ".fullops-squad/docs/evaluations/**",
    ".fullops-squad/board/**"
  ],
  "rules": [
    {
      "code": "SLOP-001",
      "description": "any로 타입 검사를 우회하는 표현",
      "pattern": "\\bas\\s+any\\b|:\\s*any\\b",
      "file_extensions": [".ts", ".tsx", ".vue", ".svelte"],
      "severity": "WARNING",
      "suggestion": "정확한 타입 또는 unknown과 입력 검증을 사용한다",
      "enabled": true
    },
    {
      "code": "SLOP-002",
      "description": "조건부 객체 스프레드",
      "pattern": "\\.\\.\\.\\s*\\([^\\n]*?\\?",
      "file_extensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".vue", ".svelte"],
      "severity": "WARNING",
      "suggestion": "명시적 분기보다 읽기 쉬운지 검토한다",
      "enabled": true
    },
    {
      "code": "SLOP-003",
      "description": "광범위한 예외를 pass로 숨김",
      "pattern": "except\\s+(?:Exception|BaseException)(?:\\s+as\\s+\\w+)?\\s*:(?:[ \\t]*#[^\\n]*)?\\s*pass\\b",
      "file_extensions": [".py"],
      "multiline": true,
      "severity": "WARNING",
      "suggestion": "구체적 예외를 처리하거나 의도적 무시의 근거를 기록한다",
      "enabled": true
    },
    {
      "code": "SLOP-004",
      "description": "디버그 출력 잔재 의심",
      "pattern": "\\bconsole\\.log\\s*\\(|\\bprint\\s*\\(",
      "file_extensions": [".py", ".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".vue", ".svelte"],
      "severity": "WARNING",
      "suggestion": "필요한 사용자 출력인지 확인하고 디버그 잔재는 제거한다",
      "enabled": true
    },
    {
      "code": "DESIGN-001",
      "description": "하드코딩 색 의심",
      "pattern": "(?i)(?<![\\w#])#(?:[0-9a-f]{8}|[0-9a-f]{6}|[0-9a-f]{4}|[0-9a-f]{3})(?![\\w-])|\\b(?:rgba?|hsla?|hwb|lab|lch|oklab|oklch)\\(\\s*[+-]?(?:\\d|\\.\\d)",
      "file_extensions": [".css", ".scss", ".less", ".html", ".svg", ".js", ".jsx", ".ts", ".tsx", ".vue", ".svelte"],
      "severity": "WARNING",
      "suggestion": "프로젝트 테마 토큰을 사용하고 토큰 정의·브랜드 원본의 예외는 근거와 함께 좁게 설정한다",
      "exclude_patterns": ["^\\s*--[\\w-]+\\s*:"],
      "exclude_paths": [],
      "enabled": true
    },
    {
      "code": "DESIGN-002",
      "description": "인라인 스타일 의심",
      "pattern": "\\bstyle\\s*=\\s*[\"'{]",
      "file_extensions": [".html", ".svg", ".js", ".jsx", ".ts", ".tsx", ".vue", ".svelte"],
      "severity": "WARNING",
      "suggestion": "테마 토큰·공용 컴포넌트 variant를 우선하고 동적 값이면 필요성을 기록한다",
      "exclude_patterns": [],
      "exclude_paths": [],
      "enabled": true
    },
    {
      "code": "DESIGN-003",
      "description": "임의 Tailwind 값 의심",
      "pattern": "\\b[a-z][a-z0-9-]*-\\[(?!(?:var|env)\\(|--)[^\\]\\r\\n]+\\]",
      "file_extensions": [".css", ".scss", ".html", ".js", ".jsx", ".ts", ".tsx", ".vue", ".svelte"],
      "severity": "WARNING",
      "suggestion": "테마 토큰·스케일 값을 사용하고 디자인 계약은 프로젝트 디자인 린트로 확인한다",
      "exclude_patterns": [],
      "exclude_paths": [],
      "enabled": true
    }
  ]
}
