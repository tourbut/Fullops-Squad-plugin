{
  "design": "Keep the isolated todo fixture and theme toggle, add a viewport meta tag, raise input border contrast to at least 3:1 on both surfaces, and make the form wrap so 320/390/1280 widths do not overflow.",
  "html": "<!doctype html><html lang=\"en\" data-theme=\"light\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Isolated engine fixture</title><style>html{color-scheme:light}:root,html[data-theme=light]{--bg:#f4f4f2;--fg:#1a1a1a;--surface:#fff;--border:#5c5c5c;--accent:#215e4b;--focus:#0b57d0}html[data-theme=dark]{color-scheme:dark;--bg:#161616;--fg:#f3f3f0;--surface:#1c1c1c;--border:#8a8a8a;--accent:#8fbfb2;--focus:#8ab4f8}*{box-sizing:border-box}html,body{margin:0;max-width:100%}body{background:var(--bg);color:var(--fg);font:16px sans-serif}main{width:100%;max-width:40rem;padding:1rem}h1{font-size:1.35rem;margin:0 0 .75rem}form,ul,#theme{margin:0 0 .75rem;max-width:100%}form{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem}label{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;min-width:0;max-width:100%;flex:1 1 12rem}input{min-width:0;max-width:100%;height:32px;border:1px solid var(--border);background:var(--surface);color:var(--fg);font:inherit}input:not([type=checkbox]){width:240px;flex:1 1 10rem}input[type=checkbox]{width:auto;height:auto;flex:0 0 auto}button,a{font:inherit;max-width:100%;overflow-wrap:anywhere}button{min-height:32px;padding:0 .7rem;border:1px solid var(--border);background:var(--surface);color:var(--fg)}button:disabled{opacity:.55}a{color:var(--accent)}ul{padding:0;list-style:none}li{padding:12px;border:1px solid var(--border);background:var(--surface);margin:0 0 .4rem;overflow-wrap:anywhere}:focus-visible{outline:3px solid var(--focus);outline-offset:2px}@media (prefers-reduced-motion:no-preference){html,body,button,input,a,li{transition:background-color .2s ease,color .2s ease,border-color .2s ease}}</style><main><button type=\"button\" id=\"theme\" aria-pressed=\"false\">Theme: light</button><h1>Todo fixture</h1><form><label>New todo <input id=\"todo\" autocomplete=\"off\"></label><button>Add</button></form><ul id=\"list\"></ul><button disabled>Restricted</button><a href=\"https://blocked.invalid/\">Outside</a><button id=\"network\">Unapproved request</button><form action=\"https://blocked.invalid/\"><button>Foreign form submit</button></form><form><button formaction=\"https://blocked.invalid/override\">Foreign submit override</button></form></main><script>window.submits=0;const form=document.querySelector('form'),input=document.querySelector('input');form.onsubmit=event=>{event.preventDefault();window.submits++;const li=document.createElement('li');const label=document.createElement('label');const box=document.createElement('input');box.type='checkbox';box.setAttribute('aria-label','Toggle milk');label.append(box,document.createTextNode(input.value));li.append(label);document.querySelector('ul').append(li);};input.onkeydown=event=>{if(event.key==='Enter'){event.preventDefault();form.requestSubmit();}};document.querySelector('#network').onclick=()=>fetch('/forbidden',{method:'POST'}).catch(()=>{});const root=document.documentElement;root.dataset.theme='light';const theme=document.getElementById('theme');theme.onclick=()=>{const next=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=next;theme.setAttribute('aria-pressed',String(next==='dark'));theme.textContent='Theme: '+next;};</script>",
  "critique": "Input borders now exceed 3:1 against adjacent surfaces in both themes, viewport meta plus wrapping prevent overflow at 320/390/1280, and theme, keyboard, reduced-motion, and fixture IDs/behavior remain intact."
}
