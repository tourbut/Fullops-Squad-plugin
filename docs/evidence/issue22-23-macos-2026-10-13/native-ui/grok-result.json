{
  "design": "Keep the existing self-contained todo fixture and add a native keyboard-accessible #theme button that starts light and toggles document.documentElement.dataset.theme between light and dark.",
  "html": "<!doctype html><html lang=\"en\" data-theme=\"light\"><meta charset=\"utf-8\"><title>Isolated engine fixture</title><style>:root{color-scheme:light;--bg:#f4f4f2;--fg:#1a1a1a;--muted:#5a5a5a;--surface:#fff;--border:#c4c4c0;--accent:#215e4b;--focus:#0b57d0}html[data-theme=dark]{color-scheme:dark;--bg:#161616;--fg:#f3f3f0;--muted:#b4b4b0;--surface:#222;--border:#3d3d3a;--accent:#8fbfb2;--focus:#8ab4f8}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:16px sans-serif}main{max-width:40rem;padding:1.25rem}h1{font-size:1.35rem;margin:0 0 .75rem}form,ul,#theme{margin:0 0 .75rem}label{display:inline-flex;align-items:center;gap:.5rem}input{width:240px;height:32px;border:1px solid var(--border);background:var(--surface);color:var(--fg);font:inherit}input[type=checkbox]{width:auto;height:auto}button,a{font:inherit}button{min-height:32px;padding:0 .7rem;border:1px solid var(--border);background:var(--surface);color:var(--fg)}button:disabled{opacity:.55}a{color:var(--accent)}ul{padding:0;list-style:none}li{padding:12px;border:1px solid var(--border);background:var(--surface);margin:0 0 .4rem}:focus-visible{outline:3px solid var(--focus);outline-offset:2px}@media (prefers-reduced-motion:no-preference){html,body,button,input,a,li{transition:background-color .2s ease,color .2s ease,border-color .2s ease}}</style><main><button type=\"button\" id=\"theme\" aria-pressed=\"false\">Theme: light</button><h1>Todo fixture</h1><form><label>New todo <input id=\"todo\" autocomplete=\"off\"></label><button>Add</button></form><ul id=\"list\"></ul><button disabled>Restricted</button><a href=\"https://blocked.invalid/\">Outside</a><button id=\"network\">Unapproved request</button><form action=\"https://blocked.invalid/\"><button>Foreign form submit</button></form><form><button formaction=\"https://blocked.invalid/override\">Foreign submit override</button></form></main><script>window.submits=0;const form=document.querySelector('form'),input=document.querySelector('input');form.onsubmit=event=>{event.preventDefault();window.submits++;const li=document.createElement('li');const label=document.createElement('label');const box=document.createElement('input');box.type='checkbox';box.setAttribute('aria-label','Toggle milk');label.append(box,document.createTextNode(input.value));li.append(label);document.querySelector('ul').append(li);};input.onkeydown=event=>{if(event.key==='Enter'){event.preventDefault();form.requestSubmit();}};document.querySelector('#network').onclick=()=>fetch('/forbidden',{method:'POST'}).catch(()=>{});const root=document.documentElement;root.dataset.theme='light';const theme=document.getElementById('theme');theme.onclick=()=>{const next=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=next;theme.setAttribute('aria-pressed',String(next==='dark'));theme.textContent='Theme: '+next;};</script>",
  "critique": "Existing labels, IDs, and form behavior remain, while the new #theme control is keyboard-accessible, starts light, keeps focus visible, and honors prefers-reduced-motion with no storage, network, or dependencies."
}
